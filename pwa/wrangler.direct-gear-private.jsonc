{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fishing-d6-wp2-test",
  "main": "./server/d6-direct-gear-worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "D6_DIRECT_GEAR_ENABLED": "true",
    "D6_DIRECT_KB_ENABLED": "true",
    "D6_DIRECT_CATCH_ENABLED": "true",
    "D6_PRODUCTION_ENABLED": "true",
    "D6_GATEWAY_ENABLED": "true",
    "D6_ORIGIN": "https://fishing-d6-wp2-test.ginosega.workers.dev",
    "D6_OWNER_GITHUB_ID": "265665562",
    "D6_REPOSITORY_ID": "1350909744",
    "D6_WP2_STAGING_ENABLED": "true",
    "D6_ISOLATED_PAGES_ENABLED": "true",
    "D6_STATIC_ENABLED": "true",
    "D6_SESSION_ENABLED": "true",
    "D6_OAUTH_ENABLED": "true",
    "D6_SIGNOUT_ENABLED": "true",
    "D6_SOURCE_ENABLED": "false",
    "D6_READ_TOKEN_ENABLED": "false",
    "D6_SIGNER_ENABLED": "false",
    "D6_HOSTED_PREFLIGHT_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "fishing-v3-wp3-auth-test",
      "database_id": "0d8da698-87b8-4b5e-a1e7-fe6de49e5afc"
    },
    {
      "binding": "WP3_DB",
      "database_name": "fishing-v3-wp3-operations-test",
      "database_id": "5a47841e-7874-4ec8-9fa8-be0315f6a802"
    }
  ],
  "assets": {
    "directory": "./dist-v3-pilot",
    "base_path": "/fishing",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/session"
    ],
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "D6_CSRF_KEY",
      "D6_OAUTH_CLIENT_SECRET"
    ]
  }
}
