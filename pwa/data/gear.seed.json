{
  "schemaVersion": 1,
  "dataVersion": "2026-09-01-my-gear-v1",
  "profiles": {
    "connections": {
      "line-braid": [
        {"html":"<ul><li>To leader: FG knot; Albright is the easier field alternative.</li><li>To snap: Palomar knot.</li><li>To lure: Palomar or Modified Uni for direct topwater use; otherwise use a leader.</li></ul>"}
      ],
      "line-fluoro": [
        {"html":"<ul><li>To swivel or snap: Trilene knot.</li><li>To hook: Improved Clinch or Palomar for heavier tackle.</li><li>To lure: use a snap when more action is desired; otherwise Palomar.</li><li>Wet fluorocarbon knots before tightening.</li></ul>"}
      ],
      "line-mono": [
        {"html":"<ul><li>To swivel or snap: Improved Clinch.</li><li>To hook: Improved Clinch or Palomar for heavier tackle.</li><li>To lure: use a snap when more action is desired; otherwise Palomar.</li></ul>"}
      ],
      "snap": [{"html":"<p>When using a snap on fluorocarbon line, use a Trilene knot.</p>"}],
      "swivel": [{"html":"<p>When using a swivel on fluorocarbon line, use a Trilene knot.</p>"}],
      "snap-swivel": [{"html":"<p>When fluorocarbon is tied to the swivel end, use a Trilene knot.</p>"}],
      "wacky-hook": [{"html":"<p>When using with a wacky worm, tie directly to a leader with a Palomar knot.</p>"}],
      "ned-hook": [{"html":"<p>When using with a Ned rig, tie directly with a Palomar knot.</p>"}],
      "drop-shot-hook": [{"html":"<p>Use the drop-shot knot and hook orientation described in the Drop shot technique.</p>"}],
      "chatterbait": [{"html":"<p>Tie line directly to the lure using a Palomar knot. Do not use a snap or swivel; it can disrupt blade startup and vibration. A loop knot is sometimes suggested for extra freedom in finesse situations, but the loop-knot guidance is unresolved. Retie often because vibration stresses the knot.</p>"}],
      "spinnerbait": [{"html":"<p>Tie directly. Do not use a snap or swivel because the extra hardware can interfere with the wire arm.</p>"}],
      "crankbait": [{"html":"<p>Connect the leader to a small crankbait snap or tie directly. A swivel is normally unnecessary.</p>"}],
      "jerkbait": [{"html":"<p>Connect the leader to a small snap or tie directly to the split ring. A swivel is normally unnecessary.</p>"}],
      "inline-spinner": [{"html":"<p>If using fluorocarbon or monofilament main line: <code>main line → swivel → 12–18 in leader → optional snap → spinner</code>.</p><p>If using braid plus a leader: <code>main line → 12–18 in leader → swivel → 12–18 in leader → optional snap → spinner</code>.</p><p>Use an Improved Clinch knot and retie periodically because spinner vibration stresses the knot.</p>"}],
      "wedding-ring": [{"html":"<p>Tie into the trolling rig directly; a swivel is strongly preferred for twist control.</p>"}],
      "spoon": [{"html":"<p>Connect the leader to a small snap. A swivel is optional if the spoon begins twisting or rolling.</p>"}],
      "dick-nite": [{"html":"<p>Connect the leader to a small snap. A swivel is optional if the spoon begins twisting or rolling.</p><p>Rig with split rings at top and bottom, and single hook at bottom with point toward the concave side of the spoon.</p>"}],
      "topwater": [{"html":"<p>Usually tie directly or use a small snap depending on the lure. Avoid a fluorocarbon leader when it pulls a floating bait down.</p>"}],
      "soft-plastic": [{"html":"<p>Rig on the hook or jighead appropriate to the presentation and tie the terminal connection directly.</p>"}]
    },
    "usage": {
      "setup-spinning": [
        {"title":"Use","html":"<ul><li>Light baits such as wacky worms, drop shots, Ned rigs, small jerkbaits, inline spinners, and spoons.</li><li>Clear-water finesse presentations with light fluorocarbon leaders.</li><li>Windy conditions, vertical presentations, trout, panfish, and easy kayak control.</li></ul>"}
      ],
      "setup-baitcasting": [
        {"title":"Use","html":"<ul><li>Heavier lures such as spinnerbaits, chatterbaits, crankbaits, jigs, swimbaits, and topwaters.</li><li>Thicker cover, heavier line, accurate target casting, and stronger hooksets.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Set the internal line-type dial for mono (M), fluorocarbon (F), or braid/PE (P).</li><li>Set spool tension so the lure drops at a medium, controlled speed.</li><li>Use W/4 for light lures or wind; 3 or lower for heavier lures and calm conditions.</li><li>Thumb the spool at splashdown to avoid backlash.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/mIcaRiMC_-k?si=-07JzU0Tlcns1zB1\" target=\"_blank\" rel=\"noopener\">Shimano SLX DC XT setup ↗</a></p>"}
      ],
      "setup-spincast": [
        {"title":"Use","html":"<ul><li>Simple shore trout fishing.</li><li>PowerBait bottom rigs and bobber/worm rigs.</li><li>Small spoons and spinners if the reel casts them adequately.</li><li>Kid- and guest-friendly bank fishing.</li></ul><p>Avoid braid or straight fluorocarbon main line unless testing proves the reel handles them well.</p>"}
      ],
      "line-braid": [
        {"title":"Use","html":"<ul><li>Use with a fluorocarbon leader for most clear-water finesse and general-purpose fishing.</li><li>Braid cuts vegetation, lasts a long time, and transmits feel well; the leader adds stealth and abrasion resistance.</li><li>Bright braid improves strike visibility when a leader is used; moss green is useful for direct topwater and cover applications.</li><li>Use a controlled lift-and-reel hookset because braid has very little stretch.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/Vd2qcWQBW54?si=RHgL76r3M1T-LaUy\" target=\"_blank\" rel=\"noopener\">Braided-line setup and spooling ↗</a></p>"}
      ],
      "line-fluoro": [{"title":"Use","html":"<ul><li>Nearly invisible and sinks.</li><li>Good in clear water, deep structure, cold water, and slow retrieves.</li><li>Not ideal for topwater because it sinks.</li><li>Wet knots before tightening.</li></ul>"}],
      "line-mono": [{"title":"Use","html":"<ul><li>Floats and stretches.</li><li>Good for topwater and shallow, rocky, or snaggy cover where shock absorption helps.</li><li>Less ideal for deep lures where stretch reduces sensitivity.</li></ul>"}],
      "cylinder-weight": [{"title":"Use","html":"<p>Use as the terminal weight on a drop-shot rig. Choose the lightest weight that maintains bottom contact and control.</p>"}],
      "egg-sinker": [{"title":"Use","html":"<p>Use as a sliding sinker in a slip-sinker bottom rig, especially for trout bait fishing.</p>"}],
      "trolling-sinker": [{"title":"Use","html":"<p>Used for <a href=\"#/kb/kb-kayak-trolling\">kayak trolling</a> in <a href=\"#/kb/kb-trout-fishing\">trout fishing</a>.</p>"}],
      "glass-beads": [{"title":"Use","html":"<p>Place between an egg sinker and swivel in a slip-sinker rig to protect the knot and add a hard bead surface.</p>"}],
      "snaps": [{"title":"Use","html":"<ul><li>Use a snap for quick lure changes or when the lure has a hard-edged tie point.</li><li>Best with fast-moving or trolled lures.</li><li>Avoid on live/jig bait worked slowly, weedless presentations, and floating baits where added hardware hurts presentation.</li></ul>"}],
      "swivels": [{"title":"Use","html":"<ul><li>Use a swivel to prevent line twist with spoons, inline spinners, flashers, or circling jigging lures.</li><li>Ball-bearing swivels are preferred for lure/leader connections when spinning or trolling.</li></ul>"}],
      "snap-swivels": [{"title":"Use","html":"<ul><li>Avoid connecting snap swivels directly to small lures because they add weight and bulk.</li><li>They can be acceptable with frequently changed spinners and spoons that already have substantial hardware.</li></ul>"}],
      "wacky-hook": [{"title":"Use","html":"<p>Use with wacky-rigged stickbaits for shallow, finesse bass presentations.</p>"}],
      "ned-hook": [{"title":"Use","html":"<p>Use as the mushroom-style jighead in a Ned rig.</p>"}],
      "drop-shot-hook": [{"title":"Use","html":"<p>Use as the hook in a drop-shot rig for suspended or bottom-oriented fish.</p>"}],
      "soft-plastic-hook": [{"title":"Use","html":"<p>Use with soft-plastic presentations; select the rigging method for the specific bait and technique.</p>"}],
      "swimbait-jig": [{"title":"Use","html":"<p>Use with swimbaits and other jighead-mounted soft plastics.</p>"}],
      "trout-hook": [{"title":"Use","html":"<p>Use for trout fishing and other natural-bait presentations. Aberdeen/long-shank hooks are useful for nightcrawlers.</p>"}],
      "chatterbait": [
        {"title":"Use","html":"<ul><li>Grass, stained or muddy water, shallow cover, docks, and channel edges.</li><li>Good for active fish and reaction bites.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Retrieve above grass, pop and pause, or let the bait sink and pop it off bottom.</li><li>A delayed hookset can help when the first thump is the fish pulling the lure in.</li></ul>"},
        {"title":"Resources","html":"<p>Article: <a href=\"https://barbcatchfishing.com/best-z-man-chatterbait/\" target=\"_blank\" rel=\"noopener\">Z-Man ChatterBait comparison ↗</a></p><p>Video: <a href=\"https://youtu.be/s28Z9NUaCTg?si=rBkQIi_pRZiMfJuO\" target=\"_blank\" rel=\"noopener\">ChatterBait trailer guidance ↗</a></p>"}
      ],
      "spinnerbait": [
        {"title":"Use","html":"<ul><li>Lakes, coves, wood, rock, and places where bass chase baitfish.</li><li>Useful around wood because the wire frame deflects well.</li><li>Flash and vibration can be productive in cooler water.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Cast through sparse cover or along edges and deflect off wood, rocks, docks, or weeds.</li><li>Pop the rod tip after the cast to start the blades.</li><li>Retrieve faster for shallow water and slower for deeper water.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/r-ba-GqRQOM?si=oP4wTDRYOCPRuGnp\" target=\"_blank\" rel=\"noopener\">Spinnerbait fishing tips ↗</a></p>"}
      ],
      "crankbait": [
        {"title":"Use","html":"<ul><li>Fish around rock, structure edges, and vegetation edges.</li><li>Avoid heavy vegetation where treble hooks snag easily.</li><li>Crankbaits are most effective when contacting rock, wood, ledges, or bottom.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Cast past the target, crank to depth/contact, then pause 1–3 seconds.</li><li>Rod tip down generally runs the bait deeper; tip up keeps it shallower.</li><li>Vary retrieve speed and pauses.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://www.youtube.com/playlist?list=PL-eAFjbtsS0I5bF46sNV62sY5gMdeunap\" target=\"_blank\" rel=\"noopener\">Crankbait fishing playlist ↗</a></p>"}
      ],
      "jerkbait": [
        {"title":"Use","html":"<p>Use as a baitfish imitator when fish respond to dart-pause action, especially in clear water and cooler conditions.</p>"},
        {"title":"Technique","html":"<p>Use twitches or jerks followed by pauses. Let the bait's buoyancy/suspending behavior determine pause length.</p>"}
      ],
      "inline-spinner": [
        {"title":"Use","html":"<ul><li>Clear, cold rivers, creeks, and lakes; along deep cover edges, over cover, or on current seams.</li><li>Avoid heavy cover because treble hooks snag easily.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Pop the rod tip after casting to start the blade.</li><li>Retrieve steadily just under the surface or a few feet down.</li><li>Retrieve slower in cold water and faster in warm water.</li><li>In streams, cast upstream at roughly a 1:00 or 11:00 angle and guide the lure past cover.</li></ul>"},
        {"title":"Color","html":"<ul><li>Clear water: silver, copper, natural.</li><li>Stained water: gold, chartreuse, black with bright dots.</li><li>Low light: glow, fluorescent, or UV.</li></ul>"}
      ],
      "spoon": [{"title":"Use","html":"<p>Cast or troll for trout, cutthroat, perch, and other predators. Vary retrieve speed and depth; add a swivel only if the spoon twists the line.</p>"}],
      "dick-nite": [{"title":"Use","html":"<p>Cast or troll as a subtle trout/cutthroat spoon. Fish it with a bit of nightcrawler or PowerBait egg on the hook.</p>"}],
      "trolling-attractor": [{"title":"Use","html":"<p>Use as part of a trout/kokanee trolling rig behind the appropriate weight and leader.</p>"}],
      "topwater": [{"title":"Use","html":"<p>Use on the surface around weed edges, points, shoreline shade, docks, and other cover, especially in calm low-light periods.</p>"}],
      "jig": [
        {"title":"Use","html":"<ul><li>Fish standard/casting jigs around docks, rocks, wood, and weed lines.</li><li>Football jigs excel on deeper rocky structure.</li></ul>"},
        {"title":"Technique","html":"<p>Let the jig reach the target depth, then hop, drag, or pause it according to cover and jig style.</p>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/ulc6fJ1AVrc?si=QBCf5PBBIBkDvAL_\" target=\"_blank\" rel=\"noopener\">How to fish every style of jig ↗</a></p>"}
      ],
      "soft-plastic-swimbait": [
        {"title":"Use","html":"<ul><li>Target larger fish in clear water and around baitfish schools, especially post-spawn and in fall.</li><li>Fish around points, ledges, weed edges, docks, and submerged structure.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Retrieve slow and steady.</li><li>Adjust retrieve speed or weight to control depth.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/dOgX9l18DQk\" target=\"_blank\" rel=\"noopener\">How to rig a soft jerkbait ↗</a></p>"}
      ],
      "senko": [
        {"title":"Use","html":"<ul><li>Use for finicky or pressured bass from spring through early fall, especially around the spawn and post-spawn.</li><li>Best in clear to lightly stained shallow water around cover, docks, grass edges, and visible fish.</li></ul>"},
        {"title":"Technique","html":"<ul><li>Cast, let the Senko fall, twitch lightly, and pause.</li><li>In water deeper than about 5 ft, pause long enough for it to sink and wiggle.</li><li>Wait until you feel the fish's weight before setting the hook.</li></ul>"},
        {"title":"Resources","html":"<p>Video: <a href=\"https://youtu.be/FBWjutCCV9Q?si=Z9Ng67D-LSa7umtT\" target=\"_blank\" rel=\"noopener\">Wacky Rig - Wendell Fishing ↗</a></p>"}
      ],
      "ned-plastic": [{"title":"Use","html":"<p>Use the included Green Pumpkin plastics with the Ned rig or related finesse presentations.</p>"}],
      "trout-bait": [{"title":"Use","html":"<p>Use with a slip-sinker rig for trout fishing so the floating bait can rise above bottom vegetation.</p>"}],
      "power-eggs": [{"title":"Use","html":"<p>Use in trout still-fishing or trolling rigs. Power Eggs can also tip spoons and spinners, including Dick Nite spoons.</p>"}]
    }
  },
