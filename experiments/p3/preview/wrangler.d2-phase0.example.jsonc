{
  // FISH118 D2 phase-0: SAME existing AUTH-P0 worker; NO scheduler, NO writes.
  // Private local copy may contain database UUIDs but NEVER secret values.
  // Preserve Cloudflare's existing GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // OWNER_GITHUB_ID, D2_CSRF_KEY, D2_HOST_PROBE_KEY encrypted secrets.
  "name": "fishing-auth-p0-test",
  "main": "src/d2-live-publisher-worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://fishing-auth-p0-test.ginosega.workers.dev",
    "D2_SANDBOX_REPO_ID": "1430581407",
    "D2_WRITE_ENABLED": "false",
    "D2_RUNNER_ENABLED": "false",
    "D2_READ_TOKENS_ENABLED": "false",
    "D2_TEST_HOST_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fishing-auth-p0",
      "database_id": "REPLACE_EXISTING_AUTH_P0_D1_UUID"
    },
    {
      "binding": "OPERATIONS_DB",
      "database_name": "fishing-p3-sandbox",
      "database_id": "REPLACE_EXISTING_MIGRATED_P3_D1_UUID"
    }
  ]
  // Deliberately NO triggers.crons, no App IDs, no write key and no routes.
}
